# ─────────────────────────────────────────────────────────────
# CAR – Production multi-stage Dockerfile
#
# Stage 1 (frontend-build): Build the Vite/React frontend
# Stage 2 (python-build):   Install Python packages in an isolated venv
# Stage 3 (production):     Python app with pre-built static assets
# ─────────────────────────────────────────────────────────────

# ── Stage 1: Build frontend ─────────────────────────────────
FROM node:24-bookworm-slim AS frontend-build

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --quiet --legacy-peer-deps

COPY frontend/ ./
RUN npm run build


# ── Stage 2: Build Python dependencies ──────────────────────
FROM python:3.15.2-slim-trixie AS python-build

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python -m venv "${VIRTUAL_ENV}" && \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt && \
    python -m pip check && \
    python -m pip uninstall --yes pip


# ── Stage 3: Production image ───────────────────────────────
FROM python:3.15.2-slim-trixie AS production

# Prevent Python from writing .pyc files and enable unbuffered stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

WORKDIR /app

# psycopg2 links against Debian's PostgreSQL client library.
RUN apt-get update -qq && \
    apt-get upgrade --no-install-recommends -y && \
    apt-get install --no-install-recommends -y \
      libpq5 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    printf '%s\n' 'export PATH="/opt/venv/bin:$PATH"' > /etc/profile.d/venv.sh

# Installers and their vendored dependencies are not needed at runtime.
RUN /usr/local/bin/python -m pip uninstall --yes pip && \
    rm -rf /usr/local/lib/python3.15/ensurepip

# Python dependencies
COPY requirements.txt ./
COPY --from=python-build /opt/venv /opt/venv

# Create log directory
RUN mkdir -p logs && touch logs/logfile.log

# Copy application source
COPY manage.py ./
COPY CAR/ CAR/
COPY backend/ backend/

# Copy pre-built frontend assets
COPY --from=frontend-build /build/dist/ frontend/dist/

# Collect static files (optional – uncomment when STATIC_ROOT is configured)
# RUN python3 manage.py collectstatic --noinput

EXPOSE 8000

# Default command – override in docker-compose / k8s as needed
CMD ["python3", "manage.py", "runserver", "0.0.0.0:8000"]
